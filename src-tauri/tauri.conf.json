{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kryoto Auto-fixer", "version": "0.1.0", "identifier": "to.kryo.auto-fixer",
  "build": { "devUrl": "http://localhost:1422", "frontendDist": "../dist", "beforeDevCommand": "pnpm dev", "beforeBuildCommand": "pnpm build" },
  "app": {
    "windows": [{ "label": "main", "title": "Kryoto Auto-fixer", "width": 460, "height": 460, "minWidth": 460, "minHeight": 460, "resizable": false, "center": true, "decorations": false, "theme": "Dark", "backgroundColor": "#0a0a0a" }],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost" }
  },
  "bundle": { "active": false, "icon": ["icons/icon.ico"], "publisher": "Kryoto", "homepage": "https://kryo.to", "copyright": "Kryoto" }
}
